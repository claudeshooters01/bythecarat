# Copy to .env and fill in real values. Never commit .env.

# 32+ char random secret for signing session JWTs.
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres connection string.
#   Local dev:   postgres://postgres:postgres@localhost:5432/bythecarat
#   Production:  Neon pooled connection string (the -pooler host), e.g.
#                postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bythecarat

# Canonical site origin — used for SEO metadata, sitemap, robots and JSON-LD.
# Set to your production domain on Vercel, e.g. https://bythecarat.in
SITE_URL=http://localhost:3000

# ── Payments ──
# Razorpay (Dashboard → Settings → API Keys). When BOTH are unset the app
# falls back to a mock provider so the full order flow runs locally and in CI
# without a merchant account. Never expose the secret to the browser.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook secret (Dashboard → Settings → Webhooks). Required in production:
# without it every webhook is rejected, so no order can ever be marked paid.
# RAZORPAY_WEBHOOK_SECRET=

# Vercel Blob token (Vercel → Storage → Blob). Product photography uploaded in
# the Studio goes to Blob's CDN when this is set. Without it, uploads are
# written to ./data/uploads and served from /uploads/<id> — fine locally, but
# NOT viable on Vercel, whose filesystem is ephemeral and read-only. Set this
# before using the Studio uploader in production.
# BLOB_READ_WRITE_TOKEN=

# Secret for the scheduled job that releases abandoned checkouts (see
# vercel.json). Vercel sends it as `Authorization: Bearer $CRON_SECRET`.
# REQUIRED in production — without it the sweep route refuses to run, and
# abandoned orders hold their stock indefinitely.
# CRON_SECRET=
#
# How long an unpaid order holds its stock before the sweep reclaims it.
# Defaults to 30 minutes.
# ORDER_HOLD_MINUTES=30

# Upstash Redis (REST) — shared rate limiting across serverless instances.
# When unset, rate limiting falls back to per-instance in-memory windows.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Seeded staff credentials (used only by scripts/seed.ts)
SEED_ADMIN_EMAIL=studio@bythecarat.in
SEED_ADMIN_PASSWORD=carat12345
